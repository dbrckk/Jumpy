; Jumpy — Godot 4.7
config_version=5

[application]
config/name="Jumpy"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.027, 0.031, 0.055, 1)

[autoload]
Profile="*res://scripts/profile.gd"
Integrations="*res://scripts/integrations.gd"

[display]
window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[gui]
theme/custom="res://assets/ui/theme.tres"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

audio/driver/enable_input=false

[input]
tap={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":32), Object(InputEventKey,"physical_keycode":4194309), Object(InputEventMouseButton,"button_index":1)]
}
